<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Nothing leaves the device. The trash holds the user's own files and the models
      directory holds hundreds of megabytes; neither belongs in a cloud backup or a
      device-to-device transfer.
    -->
    <cloud-backup>
        <exclude domain="file" path="trash" />
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="trash" />
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
